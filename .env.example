# ============================================================================
#  Настройки gigacrew. Скопируйте этот файл в ~/.gigacode/.env (общий для всех
#  проектов) или в .env проекта и заполните. НЕ коммитьте реальные ключи и
#  сертификаты — .env в .gitignore.
#
#  Порядок: переменные окружения > ~/.gigacode/.env > .env проекта > .env текущей
#  папки. Настройки, помеченные [безопасность], .env проекта и текущей папки задать
#  не может — это содержимое репозитория, его может прислать кто угодно: такие строки
#  пропускаются с предупреждением. Их место — переменные окружения или
#  ~/.gigacode/.env. Ключ доступа и остальные настройки работают и из .env проекта.
#
#  Адреса API и модель значений по умолчанию не имеют — задайте их сами.
#  Провайдер — GIGACREW_PROVIDER: api (по умолчанию) — API v2, схемы 1–2;
#  gigacode — бэкенд GigaCode, схема 3 (токен официального CLI GigaCode).
#  Схема авторизации API v2 выбирается автоматически:
#    1) задан GIGACREW_ACCESS_KEY            -> OAuth (Basic-ключ -> Bearer-токен);
#    2) иначе заданы GIGACREW_CERT + KEY     -> mTLS (клиентский сертификат).
# ============================================================================

# --- Обязательные ------------------------------------------------------------
# Базовый URL API вида https://<хост>/…/v1. Чат идёт на …/v2/chat/completions
# (хвост /vN заменяется на /v2), список моделей — на …/v1/models.
# Для бэкенда GigaCode — адрес бэкенда, см. схему 3. [безопасность]
GIGACREW_API_URL=

# Модель (для бэкенда GigaCode необязательна, см. схему 3).
GIGACREW_MODEL=

# --- Схема 1: OAuth по ключу -------------------------------------------------
# Ключ авторизации (base64 от "client_id:client_secret").
GIGACREW_ACCESS_KEY=

# Адрес выдачи токена (обязателен для этой схемы). [безопасность]
GIGACREW_AUTH_URL=

# Scope токена (необязательно; не задан — не передаётся).
# GIGACREW_SCOPE=

# --- Схема 2: mTLS по сертификату --------------------------------------------
# Раскомментируйте и заполните, если НЕ используете GIGACREW_ACCESS_KEY.
# Авторизация — клиентским сертификатом на TLS-уровне, токен не нужен. [безопасность]
# GIGACREW_CERT=/path/to/client.pem
# GIGACREW_KEY=/path/to/client.key

# --- Схема 3: бэкенд GigaCode ------------------------------------------------
# Раскомментируйте вместо схем 1–2: ключ и сертификат не нужны, токен — из файла
# официального CLI GigaCode (см. ниже).
# GIGACREW_PROVIDER=gigacode
#
# GIGACREW_API_URL — адрес бэкенда: https://<хост>. Конфигурация и каталог моделей —
# …/api/v2/config, чат — по адресу из конфигурации; адрес, который кончается на
# /api/vN или /config, берётся как есть.
#
# User-Agent всех запросов к бэкенду (конфигурация, чат) — как есть, только
# печатные ASCII-символы. Обязателен, значения по умолчанию нет: на время демо его
# задаёт команда бэкенда.
# GIGACREW_USER_AGENT=
#
# GIGACREW_MODEL необязательна: без неё — модель бэкенда по умолчанию; модель вне
# каталога бэкенда — ошибка (список — gigacrew --list-models). Окна моделей — тоже из
# каталога: замерять их не нужно (gigacrew --test-context по-прежнему можно).
#
# Токен: gigacrew сам не входит в бэкенд, а читает токен официального CLI GigaCode из
# $GIGACODE_HOME/gigacode_token.json (по умолчанию ~/.gigacode/gigacode_token.json).
# Файла нет, токен истёк или бэкенд его не принял — пройдите авторизацию в GigaCode:
# новый токен подхватится без перезапуска gigacrew. [безопасность]
# GIGACODE_HOME=
#
# Температура — GIGACREW_TEMPERATURE (а не из каталога бэкенда); max_tokens не
# передаётся.
#
# Проверка TLS включена по умолчанию, как в официальном CLI: токен — его. Доверенные
# корни — стандартные, сертификаты официального CLI ($GIGACODE_HOME/certs/*.pem и
# *.crt, туда CLI кладёт свой корневой сертификат) и GIGACREW_CA_BUNDLE (ниже).
# GIGACREW_VERIFY_SSL=0 выключает проверку — токен тогда можно перехватить.

# --- Общие настройки ---------------------------------------------------------
# Проверка TLS-сертификата сервера включена по умолчанию (все схемы): без неё ключ,
# токен и код проекта можно перехватить подменой сервера. Корни — стандартные
# (certifi, как у httpx, и системное хранилище). Если корень сертификата сервера в
# них не входит (корпоративный УЦ), укажите его (PEM) — у API v2 тогда проверка идёт
# только по нему, у бэкенда GigaCode — в дополнение к стандартным. [безопасность]
# GIGACREW_CA_BUNDLE=/path/to/root_ca.pem
# "0" — не проверять (небезопасно; при запуске — предупреждение). [безопасность]
# GIGACREW_VERIFY_SSL=1

GIGACREW_TIMEOUT=120

# Сколько ждать ответа модели, с (не меньше GIGACREW_TIMEOUT): вызовы инструментов
# приходят целиком в конце ответа, и пока модель пишет длинный план или файл, данные
# не идут. Короткое ожидание обрывает такой ответ после «сейчас запишу план».
# GIGACREW_READ_TIMEOUT=600

# Сколько ждать, если шлюз ответил 429 (лимит запросов), с на один запрос: паузы от 5
# до 30 с, о каждой — уведомление. 0 — не ждать, сразу ошибка.
# GIGACREW_RATE_LIMIT_WAIT=120

# Начальный режим разрешений: auto — правки файлов без вопросов, изменяющие команды
# проверяет модель-рецензент (сомнительные и опасные — с подтверждением); plan — только
# исследование и план. Прежние manual и edits означают auto.
# В работе режим меняется Shift+Tab или /mode; --mode при запуске перекрывает.
# GIGACREW_MODE=auto

# Модель-рецензент изменяющих команд в режиме auto; не задана — модель чата (та, что
# выбрана сейчас, в том числе /model). Если такой модели нет, при запуске выводится
# предупреждение и рецензент отключается — команды подтверждаются вручную.
# GIGACREW_REVIEWER_MODEL=

# Сколько ждать ответа рецензента, с. Не ответил — один запрос без повтора, и команду
# подтверждаете вы: при медленной модели вопрос приходит сразу, а не через 10+ минут.
# GIGACREW_REVIEWER_TIMEOUT=60

# Команды, которые только читают проект (ls, grep, git log, python без записи), —
# без вопроса в любом режиме; 0 — каждая команда с подтверждением.
# GIGACREW_SAFE_COMMANDS=1

# Ответ «a» на вопрос о команде запоминается для проекта в ~/.gigacode/projects/
# (переживает сессии; /permissions — список); 0 — только до конца сессии.
# GIGACREW_REMEMBER_APPROVALS=1

# Сжатие контекста: когда история занимает GIGACREW_COMPACT_THRESHOLD процентов
# бюджета истории, её начало сворачивается в краткое содержание. 0 — не сжимать
# автоматически (вручную — /compact; сверх бюджета старое просто отбрасывается).
# GIGACREW_AUTO_COMPACT=1
# GIGACREW_COMPACT_THRESHOLD=80

# Явный бюджет запроса (оценка в токенах); без него — от замеренного окна модели.
# GIGACREW_CONTEXT_TOKENS=60000

# Предлагать замер окна незамеренной модели (пробы оплачиваются); 0 — только
# gigacrew --test-context.
# GIGACREW_AUTO_MEASURE=1

# Температура генерации (0–2).
# GIGACREW_TEMPERATURE=0.2

# Возвращать модели её рассуждения: turn — в пределах хода, до следующего запроса
# пользователя (так советуют вендоры моделей с рассуждениями; запрос растёт); off — нет.
# Модели без рассуждений это не касается. Шлюз не принял рассуждения модели — дальше
# она работает без них (уведомление).
# GIGACREW_REASONING=turn

# Сохранять чаты и журнал решений о командах в ~/.gigacode/projects/
# (0 — не сохранять, как --no-save).
# GIGACREW_SAVE_CHATS=1

# Точная навигация по Python-коду через ty (LSP-сервер, локально); 0 — только индекс.
# GIGACREW_TY=1

# Ограничители одной вложенной задачи (инструмент task): шаги, заполнение контекста
# (процент окна модели; окно не замерено — от 32k) и время в секундах. На исчерпании
# задача подводит итог и возвращает отчёт.
# GIGACREW_SUBAGENT_MAX_STEPS=25
# GIGACREW_SUBAGENT_CONTEXT=80
# GIGACREW_SUBAGENT_TIMEOUT=600

# --- Модель для live-тестов (pytest -m live) ---
# GIGACREW_TEST_MODEL=

# --- Поведенческие сценарии (make eval) и пробы шлюза (make probe) ---
# Модели через запятую (по умолчанию — GIGACREW_TEST_MODEL).
# GIGACREW_EVAL_MODELS=
# Повторов каждого сценария: поведение модели случайно.
# GIGACREW_EVAL_RUNS=3
# Метка отчёта (например, baseline-t02) и папка отчётов (по умолчанию .gigacode/evals).
# GIGACREW_EVAL_LABEL=
# GIGACREW_EVAL_DIR=
# Предел одного прогона сценария, с.
# GIGACREW_EVAL_TIMEOUT=1800
